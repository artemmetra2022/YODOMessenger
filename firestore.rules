rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // НОВОЕ (AC): раздел «Жалобы» для двух главных админов
    // использует collection-group запрос ко всем подколлекциям reports сразу.
    // Обычные права ниже (по participantIds) действуют для запросов внутри
    // одного чата; этот блок даёт двум админам сквозной доступ на чтение.
    match /{path=**}/reports/{reportId} {
      allow read: if isOfficialChannelAdmin();
    }

    // НОВОЕ (одноразовые медиа "на один просмотр"): получатель (не автор) view-once
    // фото должен иметь возможность стереть imageBase64 и пометить viewOnceOpened=true
    // сразу после полноэкранного просмотра — иначе фото так и останется читаемым на
    // сервере. Разрешаем ТОЛЬКО такое узкое обновление: сообщение уже было view-once
    // и ещё не открыто, изменяются исключительно поля imageBase64 (стирается) и
    // viewOnceOpened (ставится в true), автор/текст/время и т.п. остаются нетронутыми.
    function isViewOnceOpenUpdate() {
      return isSignedIn() &&
        resource.data.isViewOnce == true &&
        resource.data.viewOnceOpened != true &&
        request.resource.data.viewOnceOpened == true &&
        !("imageBase64" in request.resource.data) &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(["imageBase64", "viewOnceOpened"]);
    }

    function isOfficialChannelAdmin() {
      // Только два доверенных email-адреса (аккаунты создателей приложения)
      // могут писать в официальный канал рассылок.
      return isSignedIn() &&
        request.auth.token.email.lower() in
          ['artemmetra2022spb@gmail.com', 'artemmelnik2@yandex.ru'];
    }

    // НОВОЕ (модерация групп/каналов): владелец чата, назначенный админ, либо
    // участник с ролью, дающей право DELETE_MESSAGES (встроенные Модератор/Помощник
    // или кастомная роль с этим правом). Только для групп/каналов — в личных чатах
    // модерации чужих сообщений нет. Все обращения к maps/list защищены проверками
    // is map / is string / is list: в старых чатах поля roles/customRoles/builtIn
    // могут отсутствовать, а обращение к null в правилах бросает ошибку, которая
    // из-за отсутствия полного short-circuit в `||` отклоняла бы запрос целиком
    // (включая легитимные ветки реакций/закреплений ниже).
    function isChatModerator(chatId) {
      return isSignedIn() &&
        get(/databases/$(database)/documents/chats/$(chatId)).data.type in ['GROUP', 'CHANNEL'] && (
          request.auth.uid == get(/databases/$(database)/documents/chats/$(chatId)).data.createdBy ||
          request.auth.uid in (get(/databases/$(database)/documents/chats/$(chatId)).data.adminIds is list
            ? get(/databases/$(database)/documents/chats/$(chatId)).data.adminIds : []) ||
          (
            get(/databases/$(database)/documents/chats/$(chatId)).data.roles is map &&
            request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.roles &&
            (
              (
                get(/databases/$(database)/documents/chats/$(chatId)).data.roles[request.auth.uid].builtIn is string &&
                get(/databases/$(database)/documents/chats/$(chatId)).data.roles[request.auth.uid].builtIn
                  in ['MODERATOR', 'ASSISTANT']
              ) ||
              (
                get(/databases/$(database)/documents/chats/$(chatId)).data.roles[request.auth.uid].customRoleId is string &&
                get(/databases/$(database)/documents/chats/$(chatId)).data.customRoles is map &&
                get(/databases/$(database)/documents/chats/$(chatId)).data.roles[request.auth.uid].customRoleId
                  in get(/databases/$(database)/documents/chats/$(chatId)).data.customRoles &&
                'DELETE_MESSAGES' in (
                  get(/databases/$(database)/documents/chats/$(chatId)).data.customRoles[
                    get(/databases/$(database)/documents/chats/$(chatId)).data.roles[request.auth.uid].customRoleId
                  ].permissions is list
                    ? get(/databases/$(database)/documents/chats/$(chatId)).data.customRoles[
                        get(/databases/$(database)/documents/chats/$(chatId)).data.roles[request.auth.uid].customRoleId
                      ].permissions
                    : []
                )
              )
            )
          )
        );
    }

    // НОВОЕ (чат поддержки): беседы поддержки имеют id вида support_<uid>.
    // Доступ: сам владелец (support_<его uid>) либо админ поддержки (те же email).
    function isSupportChat(chatId) {
      return chatId.matches('support_.*');
    }
    function canAccessSupportChat(chatId) {
      return isSignedIn() &&
        (chatId == 'support_' + request.auth.uid || isOfficialChannelAdmin());
    }

    // НОВОЕ (AD): глобальные блокировки аккаунтов. Читать свою запись может
    // сам пользователь (чтобы показать экран «Вы заблокированы»), а также
    // два админа. Создавать/снимать блокировку могут ТОЛЬКО два админа.
    match /globalBlocks/{blockedUserId} {
      allow read: if isSignedIn() &&
        (request.auth.uid == blockedUserId || isOfficialChannelAdmin());
      allow create, update, delete: if isOfficialChannelAdmin();
    }

    // ИСПРАВЛЕНО (AR/AT): список всех глобальных блокировок (раздел
    // «Заблокированные пользователи») — списочный запрос доступен только админам.
    match /globalBlocks/{document=**} {
      allow read: if isOfficialChannelAdmin();
    }

    // НОВОЕ: глобальные настройки приложения (сейчас — только флаг
    // requireEmailVerification, переключатель "требовать подтверждение почты
    // при входе"). Читать может кто угодно, даже без авторизации — значение
    // нужно ДО завершения логина, чтобы решить, показывать ли экран
    // "подтвердите почту". Менять могут только 2 доверенных email.
    match /config/appSettings {
      allow read: if true;
      allow write: if isOfficialChannelAdmin();
    }

    match /users/{userId} {
      // Публичное чтение нужно для входа по username (email резолвится ДО
      // авторизации в FirebaseAuth) и для профилей пользователей.
      // ВАЖНО: поле twoFactor.enabled — это флаг "включена ли 2FA по email",
      // не секрет (нужен экрану входа, чтобы понять, что после пароля нужно
      // запросить email-код), поэтому владелец пишет его прямо сюда.
      // Секретные данные (хэш/соль email-кода) — в подколлекции /security,
      // публично недоступной даже для владельца через этот документ.
      // ИСПРАВЛЕНО (безопасность): раньше allow read: if true разрешал и get, и
      // list — кто угодно, даже без авторизации, мог выкачать коллекцию users
      // целиком со всеми email. Чтение разделено: get остаётся публичным
      // (вход по username и восстановление пароля резолвят email ДО авторизации,
      // профили публичны по дизайну), а массовые запросы (list) — только для
      // авторизованных: поиск пользователей, контакты и «Кто рядом» всегда
      // выполняются уже вошедшим пользователем.
      allow get: if true;
      allow list: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == userId;

      // Сессии (устройства) — только владелец аккаунта может читать и писать.
      match /sessions/{sessionId} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }

      // НОВОЕ: приватные данные пользователя, которые нельзя раскрывать
      // публично (в частности PBKDF2 hash/salt второго пароля, 2FA, и хэш
      // 6-значного email-кода второго шага 2FA). Читать и писать может
      // только сам владелец аккаунта — то же самое правило, что и раньше,
      // теперь используется и для документа emailCode (см.
      // TwoFactorRepositoryImpl.sendEmailCode/verifyEmailCode): сам код
      // никогда не покидает устройство пользователя в открытом виде,
      // хранится только его SHA-256 хэш с солью.
      match /security/{docId} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }

      // НОВОЕ (История изменений профиля): журнал изменений владельца.
      // Правила не каскадируются на подколлекции, поэтому без этого блока
      // запись в profileHistory блокировалась и история оставалась пустой.
      match /profileHistory/{entryId} {
        allow read: if isSignedIn() && request.auth.uid == userId;
        allow create: if isSignedIn() && request.auth.uid == userId;
        allow update, delete: if isSignedIn() && request.auth.uid == userId;
      }
    }

    match /posts/{postId} {
      // Посты стены профиля — читают все авторизованные пользователи (лента
      // видна на чужих профилях так же, как на своём); создавать/менять/
      // удалять может только автор поста, и только от своего имени.
      allow read: if isSignedIn();
      allow create: if isSignedIn() &&
        request.auth.uid == request.resource.data.authorId;
      allow update, delete: if isSignedIn() &&
        request.auth.uid == resource.data.authorId;

      // НОВОЕ (AK): комментарии под постом. Читают все авторизованные,
      // пишет только сам автор комментария, а удалить может автор комментария,
      // владелец поста (модерация своей стены) или администратор.
      match /comments/{commentId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() &&
          request.auth.uid == request.resource.data.authorId;
        allow update: if isSignedIn() &&
          request.auth.uid == resource.data.authorId;
        allow delete: if isSignedIn() && (
          request.auth.uid == resource.data.authorId ||
          request.auth.uid == get(/databases/$(database)/documents/posts/$(postId)).data.authorId ||
          isOfficialChannelAdmin()
        );
      }
    }

    match /usernames/{username} {
      // Хранит только { uid }, публичное чтение необходимо, чтобы найти
      // email по username при входе (до того, как пользователь
      // аутентифицирован).
      // Запись разрешена, только если создаваемая/изменяемая запись
      // указывает на самого вызывающего — иначе любой авторизованный
      // пользователь мог бы переписать чужой username → uid маппинг.
      allow read: if true;
      allow create, update: if isSignedIn() &&
        request.resource.data.uid == request.auth.uid;
      allow delete: if isSignedIn() &&
        resource.data.uid == request.auth.uid;
    }

    match /chats/{chatId} {
      // п.41: официальный канал YodoMessenger должен быть виден и открываем
      // ВСЕМ авторизованным пользователям (это рассылка от админов, а не
      // приватный чат), поэтому для него read разрешён всем участникам,
      // а не только participantIds. Писать в сам документ чата (title,
      // lastMessage и т.п.) могут только админы канала.
      allow read: if isSignedIn() &&
        (chatId == 'yodo_official_channel'
          // ИСПРАВЛЕНИЕ (кнопка «Избранное» не реагирует на нажатие): чат
          // «Избранное» имеет детерминированный id "saved_<uid>" и на первом
          // открытии ещё не существует. get() на несуществующий документ
          // вычисляет resource как null, поэтому обращение к
          // resource.data.participantIds ниже бросает ошибку и правило
          // трактуется как запрет — из-за этого не срабатывал переход.
          // Эта ветка разрешает пользователю читать (в т.ч. проверять
          // существование) СВОЙ собственный документ "Избранное" ещё до
          // того, как он создан.
          || chatId == ('saved_' + request.auth.uid)
          || (resource != null && request.auth.uid in resource.data.participantIds)
          // НОВОЕ (админ-функции групп): открытые и модерируемые группы видны в поиске
          // и их профиль можно открыть, не будучи участником. Скрытые (HIDDEN) — нет.
          || (resource != null && resource.data.type == 'GROUP' && resource.data.accessMode != 'HIDDEN')
          || (isSupportChat(chatId) && canAccessSupportChat(chatId))
          // ИСПРАВЛЕНИЕ (админ-панель: не отображались вопросы): админу нужно
          // выполнять коллекционный запрос whereEqualTo("type","SUPPORT"). Ветка выше
          // завязана на regex по id документа (support_*), что Firestore не может
          // доказать для list-запроса (он фильтрует по полю type), и отклоняет его.
          // Эта ветка завязана на resource.data.type, который запрос и ограничивает.
          || (isOfficialChannelAdmin() && resource != null && resource.data.type == 'SUPPORT'));

      // ИСПРАВЛЕНО (безопасность): раньше любой авторизованный мог создать чат
      // с произвольными participantIds и createdBy — в том числе подменить чужое
      // «Избранное» (saved_<uid>) или беседу поддержки (support_<uid>), получив
      // контроль над их содержимым, и создать фиктивный официальный канал.
      // Теперь: чат создаётся строго от своего имени (createdBy == текущий
      // пользователь), создатель обязан быть участником, чаты с детерминированным
      // id (saved_/support_) можно создавать только для самого себя, а официальный
      // канал — только админам. Добавлять чужие uid в participantIds своего нового
      // чата по-прежнему можно — это и есть «создать группу с участниками».
      allow create: if isSignedIn() &&
        request.resource.data.createdBy == request.auth.uid &&
        request.auth.uid in request.resource.data.participantIds &&
        (!isSupportChat(chatId) || chatId == 'support_' + request.auth.uid) &&
        (!chatId.matches('saved_.*') || chatId == 'saved_' + request.auth.uid) &&
        (chatId != 'yodo_official_channel' || isOfficialChannelAdmin());

      // Обновление документа чата разбито на два случая:
      //  - официальный канал: только два доверенных админ-аккаунта;
      //  - обычный чат: участник может обновлять чат, НО не может сам себе
      //    (или кому-либо ещё) изменить поля roles/adminIds/customRoles —
      //    эти поля меняются только владельцем чата (createdBy) либо
      //    пользователем, уже присутствующим в adminIds. Это закрывает
      //    возможность обычного участника назначить себя администратором
      //    напрямую через Firestore SDK, в обход клиентских проверок прав.
      allow update: if isSignedIn() &&
        (isSupportChat(chatId)
          ? canAccessSupportChat(chatId)
          : chatId == 'yodo_official_channel'
            ? isOfficialChannelAdmin()
            : (
                request.auth.uid in resource.data.participantIds &&
                (
                  // Поля управления доступом не меняются в этом запросе —
                  // обычное редактирование чата (сообщения, черновики и т.д.)
                  !request.resource.data.diff(resource.data).affectedKeys()
                    .hasAny(['roles', 'adminIds', 'customRoles', 'participantIds'])
                  ||
                  // ...либо меняет их владелец чата или уже действующий админ.
                  request.auth.uid == resource.data.createdBy ||
                  request.auth.uid in (resource.data.adminIds is list ? resource.data.adminIds : [])
                )
                ||
                // НОВОЕ (админ-функции групп): вступление в открытую группу / подписка
                // на канал — неучастник добавляет СЕБЯ в participantIds (и обнуляет свой
                // unreadCounts), не трогая другие поля. Только для групп/каналов:
                //  - личные чаты (PRIVATE) и поддержка — нельзя;
                //  - MODERATED — только через одобрение заявки админом (ветка выше);
                //  - HIDDEN — нельзя (нет в поиске, вступление по приглашению);
                //  - отсутствующий accessMode у старых чатов считается OPEN;
                //  - забаненный (bannedUserIds) вернуться сам не может.
                (
                  !(request.auth.uid in resource.data.participantIds) &&
                  resource.data.type in ['GROUP', 'CHANNEL'] &&
                  resource.data.accessMode != 'HIDDEN' &&
                  resource.data.accessMode != 'MODERATED' &&
                  request.resource.data.diff(resource.data).affectedKeys()
                    .hasOnly(['participantIds', 'unreadCounts']) &&
                  request.auth.uid in request.resource.data.participantIds &&
                  !(
                    resource.data.bannedUserIds is list &&
                    request.auth.uid in resource.data.bannedUserIds
                  )
                )
              )
        );

      allow delete: if isSignedIn() &&
        chatId != 'yodo_official_channel' &&
        request.auth.uid == resource.data.createdBy;

      // Журнал действий администраторов: читать могут только участники чата
      // (право VIEW_ADMIN_LOG дополнительно проверяется на клиенте по
      // roles/customRoles — здесь ��а уровне правил гарантируем только
      // принадлежность к чату). Писать может только сам участник от своего
      // имени, сразу после выполненного ��м действия.
      // НОВОЕ (модерируемые каналы): заявки на вступление хранятся в подколлекции
      // joinRequests/{userId}. Создать/удалить свою заявку может сам пользователь;
      // читать список и удалять (одобрять/отклонять) — владелец или админ канала.
      // НОВОЕ (форумные группы: закрытие/удаление/закрепление/непрочитанные тем).
      // Читать список тем может любой участник чата. Создавать/закрывать/удалять —
      // только владелец или админ группы (та же проверка, что и раньше делалась
      // только на клиенте в createForumTopic). Закреплять тему у себя и отмечать
      // её прочитанной может любой участник, но ТОЛЬКО меняя свой собственный ключ
      // в картах pinned/unreadCounts — иначе можно было бы сбросить непрочитанные
      // у другого пользователя.
      match /topics/{topicId} {
        allow read: if isSignedIn() &&
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds;

        allow create: if isSignedIn() &&
          (
            request.auth.uid == get(/databases/$(database)/documents/chats/$(chatId)).data.createdBy ||
            request.auth.uid in (get(/databases/$(database)/documents/chats/$(chatId)).data.adminIds is list
              ? get(/databases/$(database)/documents/chats/$(chatId)).data.adminIds : [])
          );

        allow update: if isSignedIn() &&
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds &&
          (
            // Владелец/админ может менять что угодно в теме (закрыть, переименовать,
            // обновить превью последнего сообщения).
            request.auth.uid == get(/databases/$(database)/documents/chats/$(chatId)).data.createdBy ||
            request.auth.uid in (get(/databases/$(database)/documents/chats/$(chatId)).data.adminIds is list
              ? get(/databases/$(database)/documents/chats/$(chatId)).data.adminIds : []) ||
            // Обычный участник может менять ТОЛЬКО свой собственный ключ в pinned
            // и/или unreadCounts — например, при отправке сообщения (инкремент чужих
            // unreadCounts) это правило не подходит, для этого нужен отдельный кейс ниже.
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['pinned']) ||
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['unreadCounts']) ||
            // Отправка сообщения в тему обновляет lastMessage/lastMessageTimestamp/
            // lastMessageSenderId и инкрементирует unreadCounts всех остальных
            // участников одновременно — это законное совместное обновление любым
            // участником чата (не только владельцем/админом).
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['lastMessage', 'lastMessageTimestamp', 'lastMessageSenderId', 'unreadCounts'])
          );

        allow delete: if isSignedIn() &&
          (
            request.auth.uid == get(/databases/$(database)/documents/chats/$(chatId)).data.createdBy ||
            request.auth.uid in (get(/databases/$(database)/documents/chats/$(chatId)).data.adminIds is list
              ? get(/databases/$(database)/documents/chats/$(chatId)).data.adminIds : [])
          );
      }

      match /joinRequests/{userId} {
        allow read: if isSignedIn() &&
          (request.auth.uid == userId ||
           request.auth.uid == get(/databases/$(database)/documents/chats/$(chatId)).data.createdBy ||
           request.auth.uid in (get(/databases/$(database)/documents/chats/$(chatId)).data.adminIds is list
             ? get(/databases/$(database)/documents/chats/$(chatId)).data.adminIds : []));
        allow create: if isSignedIn() && request.auth.uid == userId &&
          // НОВОЕ (админ-функции групп): забаненный участник не может подать
          // заявку на вступление заново — только разбан владельцем/админом.
          // bannedUserIds может отсутствовать (старые чаты) — проверка is list
          // обязательна, иначе обращение к null отклоняло бы заявку любому.
          !(
            get(/databases/$(database)/documents/chats/$(chatId)).data.bannedUserIds is list &&
            request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.bannedUserIds
          );
        allow delete: if isSignedIn() &&
          (request.auth.uid == userId ||
           request.auth.uid == get(/databases/$(database)/documents/chats/$(chatId)).data.createdBy ||
           request.auth.uid in (get(/databases/$(database)/documents/chats/$(chatId)).data.adminIds is list
             ? get(/databases/$(database)/documents/chats/$(chatId)).data.adminIds : []));
        allow update: if false;
      }

      match /adminLog/{logId} {
        allow read: if isSignedIn() &&
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds;
        allow create: if isSignedIn() &&
          request.auth.uid == request.resource.data.actorId &&
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds;
        allow update, delete: if false;
      }

      // Система жалоб (п.5 ТЗ): жалобы видны только участникам чата (очередь
      // рассматривают админы — их право проверяется во ViewModel по
      // roles/adminIds, здесь на уровне правил гарантируем только
      // принадлежность к чату). Подать жалобу может любой участник от
      // своего имени.
      match /reports/{reportId} {
        allow read: if isSignedIn() &&
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds;
        allow create: if isSignedIn() &&
          request.auth.uid == request.resource.data.reporterId &&
          (
            request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds ||
            // НОВОЕ (AD): обжалование глобальной блокировки можно подать в очередь
            // официального канала даже не будучи его участником — на самого себя.
            (request.resource.data.reason == 'APPEAL' &&
             request.auth.uid == request.resource.data.targetUserId)
          );
        allow update: if isSignedIn() &&
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds;
        allow delete: if false;

        match /comments/{commentId} {
          allow read: if isSignedIn() &&
            request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds;
          allow create: if isSignedIn() &&
            request.auth.uid == request.resource.data.authorId &&
            request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds;
          allow update, delete: if false;
        }
      }

      // НОВОЕ (AD): чтение жалоб/обжалований официального канала для двух админов
      // (очередь жалоб). Обычные жалобы в других чатах — по participantIds выше.
      match /messages/{messageId} {
        // Сообщения официального канала читают все, но отправлять (create)
        // в него могут только два админа.
        // ИСПРАВЛЕНО (безопасность): раньше allow read: if isSignedIn() открывал
        // сообщения ЛЮБОГО чата любому авторизованному пользователю — прямой get()
        // по документу чужого личного чата возвращал всю переписку. Теперь читать
        // сообщения можно: в официальном канале — всем авторизованным (публичная
        // рассылка); в своём «Избранном» (saved_<uid>; документ чата может ещё не
        // существовать, поэтому get() ниже для него неприменим — та же причина,
        // что в правиле read документа чата); в чате поддержки — владельцу или
        // админу поддержки; в остальных чатах — только участникам (participantIds).
        // Правило не обращается к resource.data, поэтому корректно работает и для
        // list-запросов истории сообщений (тот же паттерн, что в topics/adminLog/
        // reports выше). Чтение исходных сообщений чужих чатов админам не нужно:
        // превью нарушителя хранится в самой жалобе (targetMessagePreview), а
        // модерация обеспечивается ветками allow update/delete ниже.
        allow read: if isSignedIn() &&
          (
            chatId == 'yodo_official_channel' ||
            chatId == ('saved_' + request.auth.uid) ||
            (isSupportChat(chatId) && canAccessSupportChat(chatId)) ||
            request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds
          );
        allow create: if isSignedIn() &&
          (chatId != 'yodo_official_channel' || isOfficialChannelAdmin()) &&
          (
            // Отправитель сообщения обязан совпадать с текущим пользователем —
            // запрещает отправку сообщений от чужого имени.
            request.auth.uid == request.resource.data.senderId ||
            // НОВОЕ (приветствие поддержки, без Cloud Functions): владелец support-чата
            // может один раз создать ровно ОДНО системное приветственное сообщение
            // от имени "support_system" — сразу при первом открытии чата поддержки.
            // Проверяем, что чат ещё пуст (сообщений от support_system ещё нет),
            // это не даёт злоупотребить правилом и наштамповать много таких сообщений.
            (
              isSupportChat(chatId) &&
              chatId == 'support_' + request.auth.uid &&
              request.resource.data.senderId == 'support_system' &&
              !exists(/databases/$(database)/documents/chats/$(chatId)/messages/support_welcome)
            )
          );

        // Редактировать/удалять сообщение может только его автор
        // (senderId == текущий пользователь), либо один из двух
        // администраторов — если это официальный канал.
        // НОВОЕ (модерация групп/каналов): дополнительно — владелец/админ чата
        // или участник с ролью DELETE_MESSAGES (isChatModerator). Для модератора
        // ветка update сужена только до «мягкого удаления» (полей, которые
        // трогает deleteMessage/deleteMessages) — полный произвольный rewrite
        // чужого сообщения остаётся доступным лишь глобальным админам.
        allow update: if isSignedIn() &&
          (
            // ИСПРАВЛЕНО (AS): админы могут модерировать сообщения в любом чате.
            isOfficialChannelAdmin() ||
            (chatId != 'yodo_official_channel' && request.auth.uid == resource.data.senderId) ||
            isViewOnceOpenUpdate() ||
            // Модератор: только форма «удаления» сообщения (isDeleted + очистка
            // медиа-полей), произвольно менять текст/автора/время нельзя.
            (
              isChatModerator(chatId) &&
              request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['isDeleted', 'text', 'imageBase64', 'fileBase64', 'fileName',
                          'fileMimeType', 'fileSizeBytes', 'locationLat', 'locationLng'])
            ) ||
            // НОВОЕ (F1 реакции + F3 просмотры): любой авторизованный пользователь
            // может ставить реакции и отмечать просмотр поста — обновля�� ТОЛЬКО эти поля.
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['reactions', 'viewedBy', 'viewCount']) ||
            // Любой авторизованный пользователь может закрепить/открепить сообщение
            // и обновлять счётчик комментариев — трогая ТОЛЬКО эти поля. Без этого
            // оптимистичное закрепление откатывалось сервером (сообщение сразу откреплялось).
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['isPinned']) ||
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['commentsCount'])
          );

        // ИСПРАВЛЕНО (AS): раньше админ мог удалить сообщение только в официальном
        // канале, поэтому удаление жалобного сообщения из раздела «Жалобы» падало с
        // ошибкой «недостаточно прав». Теперь два главных админа могут удалять любое
        // сообщение в любом чате (модерация).
        // НОВОЕ (модерация групп/каналов): то же право даёт isChatModerator.
        allow delete: if isSignedIn() &&
          (
            isOfficialChannelAdmin() ||
            isChatModerator(chatId) ||
            (chatId != 'yodo_official_channel' && request.auth.uid == resource.data.senderId)
          );

        // Комментарии к сообщениям/постам: читать и оставлять может любой
        // авторизованный пользователь (блокировка проверяется на клиенте). Автор
        // комментария обязан совпадать с текущим пользователем.
        match /comments/{commentId} {
          allow read: if isSignedIn();
          allow create: if isSignedIn() &&
            request.auth.uid == request.resource.data.senderId;
          allow delete: if isSignedIn() &&
            (request.auth.uid == resource.data.senderId || isOfficialChannelAdmin());
          allow update: if false;
        }
      }
    }
  }
}
