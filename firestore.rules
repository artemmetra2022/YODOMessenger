rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      // Публичное чтение нужно для входа по username (email резолвится ДО авторизации
      // в FirebaseAuth) и для профилей пользователей. Секретных полей (пароль и т.п.)
      // в этой коллекции нет — пароли хранит сам Firebase Auth, а не Firestore.
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;

      // Сессии (устройства) — только владелец аккаунта может читать и писать.
      match /sessions/{sessionId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
    match /posts/{postId} {
      // Посты стены профиля — читают все авторизованные пользователи (лента видна
      // на чужих профилях так же, как на своём); создавать/менять/удалять может
      // только автор поста, и только от своего имени (authorId == uid).
      allow read: if request.auth != null;
      allow create: if request.auth != null &&
        request.auth.uid == request.resource.data.authorId;
      allow update, delete: if request.auth != null &&
        request.auth.uid == resource.data.authorId;
    }
    match /usernames/{username} {
      // Хранит только { uid }, публичное чтение необходимо, чтобы найти email
      // по username при входе (до того, как пользователь аутентифицирован).
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /chats/{chatId} {
      // п.41: официальный канал YodoMessenger должен быть виден и открываем ВСЕМ
      // авторизованным пользователям (это рассылка от админов, а не приватный чат),
      // поэтому для него read разрешён всем, а не только участникам participantIds.
      // Писать в сам документ чата (title, lastMessage и т.п.) могут только админы канала.
      allow read: if request.auth != null &&
        (chatId == 'yodo_official_channel' || request.auth.uid in resource.data.participantIds);
      allow write: if request.auth != null &&
        (chatId == 'yodo_official_channel'
          ? request.auth.token.email.lower() in ['artemmetra2022spb@gmail.com', 'artemmelnik2@yandex.ru']
          : request.auth.uid in resource.data.participantIds);
      allow create: if request.auth != null;

      // НОВОЕ (журнал действий администраторов): читать лог могут только участники
      // чата (право VIEW_ADMIN_LOG проверяется на клиенте/во ViewModel по данным
      // из roles/customRoles — здесь на уровне правил гарантируем только принадлежность
      // к чату). Писать может любой участник, т.к. запись всегда делается от имени
      // авторизованного actorId сразу после выполненного им действия, ограниченного
      // отдельными правилами на изменение chats/{chatId} (roles, adminIds и т.д.).
      match /adminLog/{logId} {
        allow read: if request.auth != null &&
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds;
        allow create: if request.auth != null &&
          request.auth.uid == request.resource.data.actorId &&
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds;
        allow update, delete: if false;
      }

      // НОВОЕ (система жалоб, п.5 ТЗ): жалобы видны только участникам чата (очередь
      // рассматривают админы — их право проверяется во ViewModel по roles/adminIds,
      // здесь на уровне правил гарантируем только принадлежность к чату). Подать жалобу
      // может любой участник от своего имени; редактировать статус/решение может только
      // тот, кто уже указан как reviewedBy при create, либо любой участник при update —
      // финальная проверка прав администратора выполняется в приложении перед вызовом.
      match /reports/{reportId} {
        allow read: if request.auth != null &&
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds;
        allow create: if request.auth != null &&
          request.auth.uid == request.resource.data.reporterId &&
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds;
        allow update: if request.auth != null &&
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds;
        allow delete: if false;

        match /comments/{commentId} {
          allow read: if request.auth != null &&
            request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds;
          allow create: if request.auth != null &&
            request.auth.uid == request.resource.data.authorId &&
            request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds;
          allow update, delete: if false;
        }
      }

      match /messages/{messageId} {
        // Сообщения официального канала читают все, но отправлять (create) в него
        // могут только два админа; редактировать/удалять свои сообщения — тоже только они.
        allow read: if request.auth != null;
        allow create: if request.auth != null &&
          (chatId != 'yodo_official_channel' ||
            request.auth.token.email.lower() in ['artemmetra2022spb@gmail.com', 'artemmelnik2@yandex.ru']);
        allow update, delete: if request.auth != null &&
          (chatId != 'yodo_official_channel' ||
            request.auth.token.email.lower() in ['artemmetra2022spb@gmail.com', 'artemmelnik2@yandex.ru']);
      }
    }
  }
}
