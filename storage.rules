rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() { return request.auth != null; }
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email.lower() in ['artemmetra2022spb@gmail.com', 'artemmelnik2@yandex.ru'] ||
        (firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid)) &&
         firestore.get(/databases/(default)/documents/admins/$(request.auth.uid)).data.enabled == true)
      );
    }
    match /news_attachments/{campaignId}/{fileName} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
      allow delete: if isAdmin();
    }
  }


  match /teacherProfiles/{teacherId}/{allPaths=**} {
    allow read: if request.auth != null;
    allow write: if isAdmin() || request.auth.uid == teacherId;
    allow delete: if isAdmin() || request.auth.uid == teacherId;
  }
}
